  @@ -21,6 +21,34 @@ pub fn cross_entropy_with_grad(logits: &[f32], target: usize) -> (f32, Vec<f32>)
  +/// PaLM-style z-loss coefficient: anchors `log Σ exp(logit)` near zero
  +/// so the partition function cannot drift mid-training. 1e-4 matches
  +/// PaLM / Chinchilla.
  +pub const Z_LOSS_COEF: f32 = 1e-4;
  +
  +/// Cross-entropy + PaLM-style z-loss. Adds `λ · z²` to the loss, where
  +/// `z = log Σ_j exp(logit_j)`, and the matching `2λ z · softmax_j` term
  +/// to each logit's gradient. Used in training paths only; `evaluate()`
  +/// keeps pure CE so reported `val_bpb` stays directly comparable to
  +/// baseline runs.
  +#[must_use]
  +pub fn cross_entropy_with_grad_zloss(logits: &[f32], target: usize) -> (f32, Vec<f32>) {
  +    let max = logits.iter().copied().fold(f32::NEG_INFINITY, f32::max);
  +    let exps: Vec<f32> = logits.iter().map(|&v| (v - max).exp()).collect();
  +    let sum: f32 = exps.iter().sum();
  +    let log_z = max + sum.ln();
  +    let mut grad: Vec<f32> = exps.iter().map(|&e| e / sum).collect();
  +    let p_target = grad[target].max(1e-12);
  +    let ce_loss = -p_target.ln();
  +    let z_term = Z_LOSS_COEF * log_z * log_z;
  +    let scale = 1.0 + 2.0 * Z_LOSS_COEF * log_z;
  +    for p in grad.iter_mut() {
  +        *p *= scale;
  +    }
  +    grad[target] -= 1.0;
  +    (ce_loss + z_term, grad)
  +}
